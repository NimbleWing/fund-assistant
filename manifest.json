{
  "manifest_version": 3,
  "name": "基金助手 Fund Assistant",
  "version": "0.2.0",
  "description": "基金数据助手 —— 侧边栏面板展示本地服务状态（骨架），后续接入基金净值、持仓与提醒。",
  "author": "BExhei",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "基金助手",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:17521/*"
  ]
}
